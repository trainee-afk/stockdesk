<% if (products.length> 0) { %>
    <div class="table-card">
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <% if (reportType==="low-stock" ) { %>
                            <th>Current stock</th>
                            <th>Price</th>
                            <% } else { %>
                                <th>Quantity sold</th>
                                <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach((product)=> { %>
                        <tr>
                            <td><strong>
                                    <%= product.name %>
                                </strong></td>
                            <td><span class="sku">
                                    <%= product.sku %>
                                </span></td>
                            <% if (reportType==="low-stock" ) { %>
                                <td>
                                    <%= product.stock_quantity %>
                                </td>
                                <td>₹<%= Number(product.price).toFixed(2) %>
                                </td>
                                <% } else { %>
                                    <td>
                                        <%= product.sold_quantity %>
                                    </td>
                                    <% } %>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } else { %>
        <div class="table-card empty-state">
            <h3>No products found</h3>
            <p>
                <%= reportType==="low-stock" ? "No products are at or below this stock level."
                    : "No sales data is available yet." %>
            </p>
        </div>
        <% } %>