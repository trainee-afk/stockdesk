<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Product | StockDesk</title>

    <link rel="stylesheet" href="/css/createProduct.css">
</head>

<body>

    <main class="container">

        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h1>Add Product</h1>
                <p>Add a new product to your inventory.</p>
            </div>

            <a href="/products" class="btn btn-secondary">
                ← Back to Products
            </a>
        </div>


        <!-- Product Form -->
        <div class="form-card">

            <% if (errors?.general) { %>
                <div class="form-error" role="alert">
                    <%= errors.general %>
                </div>
                <% } %>

                    <form action="/products/new" method="POST">

                        <!-- Product Name -->
                        <div class="form-group">

                            <label for="name">
                                Product Name
                            </label>

                            <input type="text" id="name" name="name" placeholder="Enter product name"
                                value="<%= formData?.name || '' %>">

                            <% if (errors?.name) { %>
                                <p class="field-error">
                                    <%= errors.name %>
                                </p>
                                <% } %>

                        </div>


                        <!-- SKU -->
                        <div class="form-group">

                            <label for="sku">
                                SKU
                            </label>

                            <input type="text" id="sku" name="sku" placeholder="e.g. LAP-001"
                                value="<%= formData?.sku || '' %>">

                            <% if (errors?.sku) { %>
                                <p class="field-error">
                                    <%= errors.sku %>
                                </p>
                                <% } %>

                        </div>


                        <!-- Price -->
                        <div class="form-group">

                            <label for="price">
                                Price
                            </label>

                            <input type="number" id="price" name="price" placeholder="0.00" min="0" step="0.01"
                                value="<%= formData?.price || '' %>">

                            <% if (errors?.price) { %>
                                <p class="field-error">
                                    <%= errors.price %>
                                </p>
                                <% } %>

                        </div>


                        <!-- Stock Quantity -->
                        <div class="form-group">

                            <label for="stock_quantity">
                                Stock Quantity
                            </label>

                            <input type="number" id="stock_quantity" name="stock_quantity" placeholder="0" min="0"
                                step="1" value="<%= formData?.stock_quantity || '' %>">

                            <% if (errors?.stock_quantity) { %>
                                <p class="field-error">
                                    <%= errors.stock_quantity %>
                                </p>
                                <% } %>

                        </div>


                        <!-- Category -->
                        <div class="form-group">

                            <label for="categoryId">
                                Category
                            </label>

                            <select id="categoryId" name="fk_category_id">

                                <option value="">
                                    Select a category
                                </option>

                                <% categories.forEach(category=> { %>

                                    <option value="<%= category.id %>"
                                        <%=String(category.id)===String(formData?.fk_category_id) ? "selected" : "" %>
                                        >
                                        <%= category.name %>
                                    </option>

                                    <% }) %>

                            </select>

                            <% if (errors?.fk_category_id) { %>
                                <p class="field-error">
                                    <%= errors.fk_category_id %>
                                </p>
                                <% } %>

                        </div>


                        <!-- Form Actions -->
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">
                                Create Product
                            </button>

                        </div>

                    </form>

        </div>

    </main>

</body>

</html>