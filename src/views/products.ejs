<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Products | StockDesk</title>

    <link rel="stylesheet" href="/css/products.css">
</head>

<body>

    <main class="container">

        <nav class="top-nav" aria-label="Main navigation">
            <a href="/products" class="nav-brand">StockDesk</a>

            <div class="nav-links">
                <a href="/products" class="nav-link active">Products</a>

                <% if (user && user.role==="ADMIN" ) { %>
                    <a href="/orders" class="nav-link">Orders</a>
                    <a href="/products/low-stock" class="nav-link">Low Stock</a>
                    <a href="/products/top-products" class="nav-link">Top Products</a>
                    <% } %>
            </div>
        </nav>

        <div class="page-header">
            <div>
                <h1>Products</h1>
                <p>Manage your inventory.</p>
            </div>

            <% if (user && user.role==="ADMIN" ) { %>
                <a href="/products/new" class="btn btn-primary">
                    + Add Product
                </a>
                <% } %>
        </div>

        <form action="/products" method="GET" class="filters-form">
            <div class="filter-group">
                <label for="search">Search</label>
                <input type="search" id="search" name="search" value="<%= filters.search || '' %>"
                    placeholder="Search by name or SKU">
            </div>

            <div class="filter-group">
                <label for="categoryId">Category</label>
                <select id="categoryId" name="categoryId">
                    <option value="">All categories</option>
                    <% categories.forEach((category)=> { %>
                        <option value="<%= category.id %>" <%=Number(filters.categoryId)===Number(category.id)
                            ? 'selected' : '' %>
                            >
                            <%= category.name %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Apply filters</button>
            <a href="/products" class="btn btn-secondary">Clear</a>
        </form>

        <!-- Products Table -->
        <div class="table-card">

            <% if (products && products.length> 0) { %>

                <table>

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>SKU</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Category</th>
                            <!-- 
                            <% if (user && user.role==="ADMIN" ) { %>
                                <th>Actions</th>
                                <% } %>
                            -->
                        </tr>
                    </thead>

                    <tbody>

                        <% products.forEach((product, index)=> { %>

                            <tr>

                                <td>
                                    <%= ((filters.page - 1) * filters.limit) + index + 1 %>
                                </td>

                                <td>
                                    <strong>
                                        <%= product.name %>
                                    </strong>
                                </td>

                                <td>
                                    <span class="sku">
                                        <%= product.sku %>
                                    </span>
                                </td>

                                <td>
                                    ₹<%= Number(product.price).toFixed(2) %>
                                </td>

                                <td>

                                    <% if (product.stock_quantity> 0) { %>

                                        <span class="stock available">
                                            <%= product.stock_quantity %>
                                        </span>

                                        <% } else { %>

                                            <span class="stock out-of-stock">
                                                Out of stock
                                            </span>

                                            <% } %>

                                </td>

                                <td>
                                    <% const category=categories.find((item)=> Number(item.id) ===
                                        Number(product.fk_category_id)); %>
                                        <%= category ? category.name : "—" %>
                                </td>

                                <!-- <% if (user && user.role==="ADMIN" ) { %>

                                    <td>
                                        <a href="/products/<%= product.id %>/edit" class="edit-link">
                                            Edit
                                        </a>
                                    </td>

                                    <% } %> -->

                            </tr>

                            <% }) %>

                    </tbody>

                </table>

                <% } else { %>

                    <div class="empty-state">
                        <h3>No products found</h3>
                        <p>There are currently no products in the inventory.</p>
                    </div>

                    <% } %>

        </div>

        <% if (pagination && pagination.totalPages> 1) { %>
            <nav class="pagination" aria-label="Product pages">
                <% if (pagination.page> 1) { %>
                    <a class="page-link"
                        href="/products?page=<%= pagination.page - 1 %>&limit=<%= filters.limit %>&search=<%= encodeURIComponent(filters.search || '') %>&categoryId=<%= filters.categoryId || '' %>">
                        Previous
                    </a>
                    <% } %>

                        <span class="page-summary">
                            Page <%= pagination.page %> of <%= pagination.totalPages %>
                        </span>

                        <% if (pagination.page < pagination.totalPages) { %>
                            <a class="page-link"
                                href="/products?page=<%= pagination.page + 1 %>&limit=<%= filters.limit %>&search=<%= encodeURIComponent(filters.search || '') %>&categoryId=<%= filters.categoryId || '' %>">
                                Next
                            </a>
                            <% } %>
            </nav>
            <% } %>

    </main>


</body>

</html>